# Copy this file to .env and fill in your Supabase project credentials.
# Never commit .env to version control.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — required for the Admin password-reset feature in User Management.
# Find it in: Supabase Dashboard → Project Settings → API → service_role (secret).
# IMPORTANT: This key bypasses Row Level Security. Keep it secret and never share it.
VITE_SUPABASE_SERVICE_KEY=your-service-role-key-here

# Cloudinary — for shipment document uploads (free: 25 GB)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
